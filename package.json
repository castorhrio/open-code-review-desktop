{
  "name": "open-code-review-desktop",
  "productName": "Open Code Review Desktop",
  "version": "0.1.13",
  "private": true,
  "description": "Desktop wrapper for the open-code-review (ocr) CLI",
  "author": "xyris",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k -s first vite \"cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "fetch:binaries": "node build/fetch-binaries.cjs",
    "release": "node tools/release.mjs",
    "upstream:check": "node tools/upstream-watch.mjs",
    "icon": "node build/make-icon.cjs",
    "audit": "npm run audit:static && npm run audit:app",
    "audit:static": "npm run typecheck && npm run audit:packaging && npm run audit:install && npm run audit:bridge && npm run audit:config && npm run audit:diagnostics && npm run audit:uninstall && npm run audit:service && npm run audit:git && npm run audit:update && npm run audit:release && npm run audit:upstream",
    "audit:app": "npm run build && npm run audit:ui && npm run audit:ui-scaled && npm run audit:contrast && npm run audit:guards && npm run audit:exit && npm run audit:e2e && npm run audit:secrets",
    "audit:packaging": "node tools/check-packaging.mjs",
    "audit:install": "node tools/install-info-smoke.mjs",
    "audit:bridge": "node tools/bridge-contract.mjs",
    "audit:config": "node tools/config-handler-smoke.mjs",
    "audit:diagnostics": "node tools/run-diagnostics-smoke.mjs",
    "audit:uninstall": "node tools/uninstall-flush.mjs",
    "audit:service": "node tools/service-smoke.mjs",
    "audit:git": "node tools/git-service-smoke.mjs",
    "audit:update": "node tools/update-state.mjs",
    "audit:release": "node tools/release-guard-smoke.mjs",
    "audit:upstream": "node tools/upstream-watch-smoke.mjs",
    "audit:ui": "node tools/ui-audit/audit.mjs",
    "audit:ui-scaled": "cross-env SCALE=1.25 SHOT=01-review-wide,07-settings-top,09-results-findings,14-min-review,16-min-results,42-report-read,69-run-feed-full,73-results-long-finding-min,ref-file-missing node tools/ui-audit/audit.mjs && cross-env SCALE=1.5 SHOT=01-review-wide,07-settings-top,09-results-findings,14-min-review,16-min-results,42-report-read,69-run-feed-full,73-results-long-finding-min,ref-file-missing node tools/ui-audit/audit.mjs",
    "audit:contrast": "node tools/ui-audit/contrast.mjs",
    "audit:guards": "node tools/electron-guards.mjs",
    "audit:exit": "node tools/exit-flush.mjs",
    "audit:e2e": "node tools/e2e-flow.mjs",
    "audit:secrets": "node tools/secret-scan.mjs"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "^1.13.3",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.xyris.open-code-review-desktop",
    "productName": "Open Code Review",
    "copyright": "Copyright xyris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ocr-service.js",
      "git-service.js",
      "update-service.js",
      "security.js",
      "run-diagnostics.js",
      "run-handler.js",
      "config-handler.js",
      "uninstall-handler.js",
      "install-info.js",
      "package.json",
      "out/**",
      "assets/**",
      "!**/*.md",
      "!**/*.map",
      "!release/**",
      "!build/**",
      "!src/**",
      "!vibe_images/**",
      "!tools/**",
      "!.tmp-home/**",
      "!启动.bat"
    ],
    "asar": false,
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "open-code-review-desktop-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "Open Code Review",
      "uninstallDisplayName": "Open Code Review ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "open-code-review-desktop-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "open-code-review-desktop-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Open Code Review ${version}",
      "artifactName": "open-code-review-desktop-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "xyris",
      "synopsis": "open-code-review (ocr) CLI 的桌面图形界面",
      "description": "open-code-review (ocr) 命令行工具的跨平台桌面封装：可视化配置模型服务、预览审查范围、运行审查、浏览结果与历史会话。",
      "desktop": {
        "entry": {
          "Name": "Open Code Review",
          "Comment": "AI 代码审查桌面客户端",
          "Categories": "Development;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "open-code-review-desktop-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/castorhrio/open-code-review-desktop/releases/latest/download/"
      }
    ]
  }
}
