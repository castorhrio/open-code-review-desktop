{
  "name": "open-code-review-desktop",
  "productName": "Open Code Review Desktop",
  "version": "0.1.4",
  "private": true,
  "description": "Desktop wrapper for the open-code-review (ocr) CLI",
  "author": "xyris",
  "main": "main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k -s first vite \"cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "icon": "node build/make-icon.cjs"
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "^1.12.13",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.xyris.open-code-review-desktop",
    "productName": "Open Code Review",
    "copyright": "Copyright xyris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ocr-service.js",
      "git-service.js",
      "update-service.js",
      "package.json",
      "out/**",
      "assets/**",
      "!**/*.md",
      "!**/*.map",
      "!release/**",
      "!build/**",
      "!src/**",
      "!vibe_images/**",
      "!.tmp-audit/**",
      "!.tmp-home/**",
      "!启动.bat"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "open-code-review-desktop-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Open Code Review",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "open-code-review-desktop-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/castorhrio/open-code-review-desktop/releases/latest/download/"
      }
    ]
  }
}
