# dependencies
node_modules/

# build output (electron-builder)
dist/
release/
release-*/

# scratch dirs used by local runs
.tmp-audit/
.tmp-home/

# regenerated on every ui-audit run; not review artifacts
tools/ui-audit/shots/

# logs / editor / OS noise
*.log
npm-debug.log*
Thumbs.db
.DS_Store
/out

# local auto-update test scaffolding
dev-app-update.yml
.tmp-upsrv/
.tmp-ud*/

# working notes for the improvement loop — local only, not part of the shipped repo
AGENT_BACKLOG.md
AGENT_NOTES.md

# secrets — the CLI keeps its key in ~/.opencodereview/config.json, never in the
# repo, and nothing here should ever be committed. Listed defensively so that a
# stray local file cannot be added by accident.
.env
.env.*
*.pem
*.key
*.p12
.opencodereview/
credentials.json
